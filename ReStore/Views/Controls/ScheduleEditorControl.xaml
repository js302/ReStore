<UserControl x:Class="ReStore.Views.Controls.ScheduleEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <ComboBox AutomationProperties.Name="Backup schedule" x:Name="ModeCombo" MinWidth="150" FontSize="11" VerticalAlignment="Center">
                <ComboBoxItem Content="Use default interval" Tag="Default"/>
                <ComboBoxItem Content="Every N hours" Tag="EveryHours"/>
                <ComboBoxItem Content="Daily at" Tag="Daily"/>
                <ComboBoxItem Content="Weekdays at" Tag="Weekdays"/>
                <ComboBoxItem Content="Custom expression" Tag="Custom"/>
            </ComboBox>
            <TextBox AutomationProperties.Name="Schedule value" x:Name="ValueBox" Margin="8,0,0,0" MinWidth="60" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="UnitText" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <TextBlock x:Name="PreviewText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</UserControl>
