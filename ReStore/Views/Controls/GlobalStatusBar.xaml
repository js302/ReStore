<UserControl x:Class="ReStore.Views.Controls.GlobalStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Control_Loaded" Unloaded="Control_Unloaded">

    <Border Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0">
        <Button x:Name="BarButton" AutomationProperties.Name="Status bar. Opens the Activity page" Background="Transparent" BorderThickness="0" Padding="12,4" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip="Open Activity">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="OperationDot" Grid.Column="0" Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="OperationText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="ProtectionText" Grid.Column="2" FontSize="12" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="NextRunText" Grid.Column="3" FontSize="12" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="LastBackupText" Grid.Column="4" FontSize="12" Margin="16,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Button>
    </Border>
</UserControl>
