<UserControl x:Class="ReStore.Views.Controls.StorageUsagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Control_Loaded">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button AutomationProperties.Name="Refresh storage usage" x:Name="RefreshBtn" Content="Refresh" Padding="10,4" FontSize="12" Cursor="Hand"/>
                    <Button AutomationProperties.Name="Measure real size by listing storage" x:Name="MeasureBtn" Content="Refresh from storage" Padding="10,4" Margin="8,0,0,0" FontSize="12" Cursor="Hand" ToolTip="Lists the chunk objects in each storage to get the real stored size (can take a while on remote storage)"/>
                </StackPanel>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEDA2;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Storage usage" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DockPanel>

            <TextBlock x:Name="EmptyText" Text="No backups yet, so nothing is stored." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>

            <StackPanel x:Name="UsageContent">
                <UniformGrid Columns="5" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="StoredText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Stored" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="LogicalText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Latest snapshots (original size)" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="DedupText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Saved by deduplication" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="CompressionText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Saved by compression" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SnapshotsText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Snapshots" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="EstimateText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <TextBlock Text="Growth (stored size after each snapshot)" FontSize="12" FontWeight="Medium" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Height="64" Padding="6">
                    <Canvas x:Name="GrowthCanvas" ClipToBounds="True" SizeChanged="GrowthCanvas_SizeChanged" AutomationProperties.Name="Storage growth sparkline">
                        <Polyline x:Name="GrowthLine" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                    </Canvas>
                </Border>
                <TextBlock x:Name="GrowthCaption" FontSize="11" Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="ReclaimText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Button AutomationProperties.Name="Preview what retention would delete" x:Name="PreviewBtn" Content="Preview retention" Padding="10,4" Margin="12,0,0,0" FontSize="12" Cursor="Hand"/>
                    <Button AutomationProperties.Name="Open retention settings" x:Name="SettingsBtn" Content="Retention settings" Padding="10,4" Margin="8,0,0,0" FontSize="12" Cursor="Hand"/>
                </StackPanel>
                <TextBox x:Name="PreviewBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,4,0,8" Visibility="Collapsed" AutomationProperties.Name="Retention preview"/>
                <TextBlock x:Name="MeasuredText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>

                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folder" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="Storage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="Snapshots" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="Original" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="4" Text="Stored" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="5" Text="Dedup saved" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="6" Text="Compression" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Column="7" Text="Reclaimable" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <ItemsControl x:Name="GroupList" AutomationProperties.Name="Usage per folder">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Group}" ToolTip="{Binding Group}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Storage}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Snapshots}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Original}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Stored}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding DedupSaved}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="6" Text="{Binding CompressionSaved}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="7" Text="{Binding Reclaimable}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
