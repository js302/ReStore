<ui:FluentWindow x:Class="ReStore.Views.Windows.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Change encryption password" Width="500" Height="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{ui:ThemeResource ApplicationBackgroundBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Change encryption password" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                   Text="Only the key that protects your backups is re-wrapped. No backup data is uploaded again. The old password stops working for this storage. Snapshots written before the encrypted v3 format keep using the old password."/>

        <ui:PasswordBox AutomationProperties.Name="Current password" x:Name="CurrentInput" Grid.Row="2" PlaceholderText="Current password..." PasswordChanged="Password_Changed" Margin="0,0,0,10"/>
        <ui:PasswordBox AutomationProperties.Name="New password" x:Name="NewInput" Grid.Row="3" PlaceholderText="New password (min 8 characters)..." PasswordChanged="Password_Changed" Margin="0,0,0,10"/>
        <ui:PasswordBox AutomationProperties.Name="Confirm new password" x:Name="ConfirmInput" Grid.Row="4" PlaceholderText="Confirm new password..." PasswordChanged="Password_Changed" KeyDown="ConfirmInput_KeyDown" Margin="0,0,0,10"/>

        <CheckBox AutomationProperties.Name="Also create a recovery key" x:Name="RecoveryKeyCheck" Grid.Row="5" Content="Also create a recovery key (shown once)" Margin="0,0,0,10"/>

        <TextBlock x:Name="ValidationMessage" Grid.Row="6" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,10,0"/>
            <ui:Button x:Name="ChangeButton" Content="Change password" Appearance="Primary" Click="Change_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
