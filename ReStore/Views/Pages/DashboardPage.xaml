<Page x:Class="ReStore.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:behaviors="clr-namespace:ReStore.Behaviors"
    xmlns:controls="clr-namespace:ReStore.Views.Controls" Background="Transparent" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Monitor and control your backup operations" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>

                <!-- Protection status chip -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border x:Name="ProtectionChip" CornerRadius="12" Padding="10,4" Background="#1A6B7280" BorderBrush="#6B7280" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ProtectionChipDot" Width="8" Height="8" Fill="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ProtectionChipText" Text="Stopped" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NextRunText" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="BackupNowBtn" Content="Back up now" Margin="16,0,0,0" Padding="12,4" Cursor="Hand"/>
                    <Button x:Name="PauseBtn" Content="Pause &#x25BE;" Margin="8,0,0,0" Padding="12,4" Cursor="Hand">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="PauseHourItem" Header="For 1 hour"/>
                                <MenuItem x:Name="PauseTomorrowItem" Header="Until tomorrow (8:00)"/>
                                <MenuItem x:Name="PauseIndefiniteItem" Header="Until I resume"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ResumeBtn" Content="Resume" Margin="8,0,0,0" Padding="12,4" Cursor="Hand" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Staleness banner (F-5) -->
                <Border x:Name="StaleBanner" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Backups are out of date" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="StaleList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- One-time notice about anonymous usage statistics, for users who never saw the first-run wizard page -->
                <Border x:Name="TelemetryNoticeBanner" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Anonymous usage statistics" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            ReStore collects anonymous usage statistics (which features are used, success or failure, durations). It never collects file names, paths or file contents. Collection starts the next time ReStore runs. You can change this any time in Settings.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="TelemetryKeepOnBtn" Content="Keep on" Padding="12,4" Click="TelemetryKeepOnBtn_Click"/>
                            <Button x:Name="TelemetryTurnOffBtn" Content="Turn off" Padding="12,4" Margin="8,0,0,0" Click="TelemetryTurnOffBtn_Click"/>
                            <Button x:Name="TelemetryLearnMoreBtn" Content="Learn more" Padding="12,4" Margin="8,0,0,0" Click="TelemetryLearnMoreBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Update available banner: close = remind me later (until restart), Skip = not for this version -->
                <Border x:Name="UpdateBanner" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="UpdateBannerTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="UpdateBannerDetail" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UpdateNowBtn" Content="Update now" Padding="12,4" Cursor="Hand"/>
                                <Button x:Name="UpdateNotesBtn" Content="Release notes" Margin="8,0,0,0" Padding="12,4" Cursor="Hand"/>
                                <Button x:Name="UpdateSkipBtn" Content="Skip this version" Margin="8,0,0,0" Padding="12,4" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="UpdateCloseBtn" Grid.Column="1" VerticalAlignment="Top" Padding="8,4" Cursor="Hand" ToolTip="Remind me later" AutomationProperties.Name="Remind me later"
                                FontFamily="{StaticResource IconFont}" Content="&#xE711;"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Statistics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Backups Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,8,0" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TotalBackupsText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Total Backups" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Last Backup Card -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="4,0,4,0" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LastBackupText" Text="Never" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                        <TextBlock Text="Last Backup" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Watched Directories Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="4,0,4,0" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="24" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="WatchedDirsText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Watched Folders" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Watcher Status Card -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="8,0,0,0" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel HorizontalAlignment="Left">
                        <Ellipse x:Name="StatusIndicator" Width="24" Height="24" Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,8" HorizontalAlignment="Left">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="WatcherStatusText" Text="Stopped" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Watcher Status" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Storage usage (F-18) -->
            <controls:StorageUsagePanel x:Name="StorageUsage" Grid.Row="2" Margin="0,0,0,16"/>

            <!-- Action Buttons -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="StartWatcherBtn" Content="Start Watcher" Padding="20,10" Cursor="Hand"/>
                            <Button x:Name="StopWatcherBtn" Content="Stop Watcher" Margin="12,0,0,0" Padding="20,10" Cursor="Hand"/>
                            <Button x:Name="ValidateBtn" Content="Validate Config" Margin="12,0,0,0" Padding="20,10" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ManualBackupBtn" Content="Manual Backup" Padding="20,10" Cursor="Hand"/>
                            <Button x:Name="RestoreBtn" Content="Restore Backup" Margin="12,0,0,0" Padding="20,10" Cursor="Hand"/>
                            <Button x:Name="TestRestoreBtn" Content="Test Restore" Margin="12,0,0,0" Padding="20,10" Cursor="Hand" ToolTip="Restore a few random files of the latest backup to a temporary folder and check them"/>
                            <Button x:Name="SystemBackupBtn" Content="System Backup" Margin="12,0,0,0" Padding="20,10" Cursor="Hand" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Health Panel -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA80;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Backup Health" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="HealthSummaryText" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Dedup Savings" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="DedupSavingsText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <TextBlock x:Name="DedupDetailText" Text="" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Integrity Checks" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="VerificationText" Text="Never run" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="VerificationDetailText" Text="" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Restore Reliability" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="RestoreReliabilityText" Text="No attempts" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="RestoreReliabilityDetailText" Text="" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="NeedsAttentionPanel" DockPanel.Dock="Top" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Needs attention" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="NeedsAttentionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:NestedScrollBehavior.CooperativeScrolling="True">
                            <ItemsControl x:Name="DirectoryHealthList" Padding="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StalenessColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DirectoryName}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding FullPath}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding AgeLabel}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{Binding StalenessColor}"/>
                                                <Button Grid.Column="3" Content="Restore" Tag="{Binding}" Padding="8,4" FontSize="11" Cursor="Hand" IsEnabled="{Binding CanRestore}" Click="HealthRestoreBtn_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Backup Runs (F-4) -->
            <Border Grid.Row="5" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D2;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Backup Runs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="LastRunText" DockPanel.Dock="Top" Text="No backup has run yet" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:NestedScrollBehavior.CooperativeScrolling="True">
                            <ItemsControl x:Name="RunReportList" Padding="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" ToolTip="{Binding TimeTooltip}" FontSize="11" FontFamily="Consolas" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Folder}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Backup History Section -->
            <Border Grid.Row="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Recent Backups" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Button AutomationProperties.Name="Refresh backup history" x:Name="RefreshHistoryBtn" Content="↻" FontSize="16" FontWeight="Bold" Padding="8,4" Margin="12,0,0,0" Cursor="Hand" ToolTip="Refresh backup history"/>
                    </StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:NestedScrollBehavior.CooperativeScrolling="True">
                            <ItemsControl x:Name="BackupHistoryList" Padding="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Directory}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding TimeLabel}" ToolTip="{Binding TimeTooltip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Button Grid.Column="3" Content="Restore" Tag="{Binding}" Padding="8,4" FontSize="11" Cursor="Hand" IsEnabled="{Binding CanRestore}" Click="RestoreBackupBtn_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Logs Section -->
            <Border Grid.Row="7" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C3;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Activity Logs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Button AutomationProperties.Name="Clear logs" x:Name="ClearLogsBtn" Content="Clear" FontSize="12" Padding="8,4" Margin="12,0,0,0" Cursor="Hand" ToolTip="Clear logs"/>
                    </StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="12" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviors:NestedScrollBehavior.CooperativeScrolling="True">
                            <TextBox AutomationProperties.Name="Log output" x:Name="LogBox" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" Effect="{StaticResource CardShadow}" RenderOptions.ClearTypeHint="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="StorageInfoText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>