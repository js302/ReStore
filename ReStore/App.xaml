<Application x:Class="ReStore.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

            <!-- Zone Colors -->
            <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526"/>
            <SolidColorBrush x:Key="MainWindowBackgroundBrush" Color="#2D2D30"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="#3E3E42"/>

            <!-- Keyboard focus ring for custom-templated controls; uses the theme text colour so it is visible in light and dark. -->
            <Style x:Key="AppFocusVisualStyle">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="2" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Animation Durations -->
            <Duration x:Key="FastAnimation">0:0:0.15</Duration>
            <Duration x:Key="MediumAnimation">0:0:0.25</Duration>
            <Duration x:Key="SlowAnimation">0:0:0.35</Duration>

            <!-- Easing Functions -->
            <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
            <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
            <QuadraticEase x:Key="QuadEaseOut" EasingMode="EaseOut"/>

            <!-- Shadows -->
            <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="20" ShadowDepth="6" Opacity="0.12" Color="Black"/>

            <!-- Fade In Animation -->
            <Storyboard x:Key="FadeInAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MediumAnimation}" EasingFunction="{StaticResource EaseOut}"/>
            </Storyboard>

            <!-- Slide In Animation -->
            <Storyboard x:Key="SlideInAnimation">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="{StaticResource MediumAnimation}" EasingFunction="{StaticResource EaseOut}"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource MediumAnimation}" EasingFunction="{StaticResource EaseOut}"/>
            </Storyboard>

        </ResourceDictionary>
    </Application.Resources>
</Application>