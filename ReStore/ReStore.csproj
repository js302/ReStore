<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <AssemblyName>ReStore</AssemblyName>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- MSIX Packaging Properties -->
        <WindowsPackageType>MSIX</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <!-- ReStore.Core is an executable project that the WPF host references as a shared implementation assembly. -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>

        <!-- Optimization Properties -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

        <!-- Application Identity -->
        <PackageId>ReStore</PackageId>
        <Product>ReStore</Product>
        <Description>A backup and restore solution for Windows</Description>
        <PackageProjectUrl>https://github.com/js302/ReStore</PackageProjectUrl>
        <RepositoryUrl>https://github.com/js302/ReStore</RepositoryUrl>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebuggerSupport>false</DebuggerSupport>
        <EventSourceSupport>false</EventSourceSupport>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ReStore.Core\ReStore.Core.csproj" AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
        <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The version lives in Directory.Build.props. The checked-in manifests must agree with it, otherwise the build fails
         (build-msix.ps1 re-stamps the Identity version at pack time, so these are only the defaults). -->
    <Target Name="ValidateManifestVersions" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <_ExpectedManifestVersion>$(Version).0</_ExpectedManifestVersion>
            <_AppxManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Package.appxmanifest'))</_AppxManifestText>
            <_AppManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\app.manifest'))</_AppManifestText>
            <_AppxManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(_AppxManifestText), '&lt;Identity\b[^&gt;]*\bVersion="([^"]*)"').Groups[1].Value)</_AppxManifestVersion>
            <_AppManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(_AppManifestText), '&lt;assemblyIdentity\b[^&gt;]*\bversion="([^"]*)"').Groups[1].Value)</_AppManifestVersion>
        </PropertyGroup>
        <Warning Condition="'$(_AppxManifestVersion)' != '$(_ExpectedManifestVersion)'"
               Text="Package.appxmanifest Identity Version '$(_AppxManifestVersion)' does not match Directory.Build.props Version '$(Version)' (expected '$(_ExpectedManifestVersion)')." />
        <Warning Condition="'$(_AppManifestVersion)' != '$(_ExpectedManifestVersion)'"
               Text="app.manifest assemblyIdentity version '$(_AppManifestVersion)' does not match Directory.Build.props Version '$(Version)' (expected '$(_ExpectedManifestVersion)')." />
    </Target>

    <!-- Hardcodet.NotifyIcon.Wpf declares a framework reference to the whole Microsoft.WindowsDesktop.App, which drags
         ~30 MB of WinForms assemblies into the self-contained publish. Hardcodet 2.0.1 and this app only use
         System.Drawing.Common (verified: no System.Windows.Forms reference), so drop the WinForms-only assemblies. -->
    <Target Name="TrimWinFormsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <_WinFormsOnlyPublishFile Include="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(Filename)').StartsWith('System.Windows.Forms'))
                    Or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualBasic'))
                    Or '%(Filename)' == 'System.Design'
                    Or '%(Filename)' == 'System.Drawing.Design'
                    Or '%(Filename)' == 'WindowsFormsIntegration'
                    Or '%(Filename)' == 'System.Windows.Controls.Ribbon'" />
            <ResolvedFileToPublish Remove="@(_WinFormsOnlyPublishFile)" />
        </ItemGroup>
    </Target>

    <!-- Fails publish if the filter above did not remove the WinForms assemblies from the output. -->
    <Target Name="VerifyNoWinFormsInPublish" AfterTargets="Publish">
        <ItemGroup>
            <_WinFormsLeftover Include="$(PublishDir)System.Windows.Forms*.dll" />
            <_WinFormsLeftover Include="$(PublishDir)WindowsFormsIntegration.dll" Condition="Exists('$(PublishDir)WindowsFormsIntegration.dll')" />
        </ItemGroup>
        <Error Condition="'@(_WinFormsLeftover)' != ''" Text="WinForms assemblies found in the publish payload: @(_WinFormsLeftover). TrimWinFormsFromPublish should have removed them." />
    </Target>
</Project>
