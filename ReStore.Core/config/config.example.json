{
  "watchDirectories": [
    {
      "path": "%USERPROFILE%\\Desktop",
      "storageType": null
    },
    {
      "path": "%USERPROFILE%\\Documents",
      "storageType": null
    },
    {
      "path": "%USERPROFILE%\\Pictures",
      "storageType": null
    }
  ],
  "globalStorageType": "local",
  "configSchemaVersion": 4,
  "backupInterval": "01:00:00",
  "sizeThresholdMB": 500,
  "maxFileSizeMB": 100,
  "backupType": "ChunkSnapshot",
  "chunkDiffing": {
    "manifestVersion": 3,
    "compression": "auto",
    "minChunkSizeKB": 32,
    "targetChunkSizeKB": 128,
    "maxChunkSizeKB": 512,
    "rollingHashWindowSize": 64,
    "maxChunksPerFile": 200000,
    "maxFilesPerSnapshot": 200000
  },
  "retention": {
    "enabled": true,
    "keepLastPerDirectory": 5,
    "maxAgeDays": 30,
    "keepHourly": 0,
    "keepDaily": 0,
    "keepWeekly": 0,
    "keepMonthly": 0,
    "keepYearly": 0,
    "mode": "any"
  },
  "verification": {
    "enabled": false,
    "verifyInterval": "7.00:00:00",
    "localStorageOnly": true,
    "snapshotsPerRun": 2,
    "mode": "full",
    "samplePercent": 5
  },
  "notifications": {
    "enabled": true,
    "notifyOnBackupFailure": true,
    "notifyOnVerificationFailure": true,
    "notifyOnRecovery": true,
    "notifyOnEveryBackupSuccess": false
  },
  "logging": {
    "level": "Info"
  },
  "protection": {
    "autoStart": true
  },
  "telemetry": {
    "enabled": true,
    "crashReports": "ask"
  },
  "updates": {
    "checkAutomatically": true,
    "includePrereleases": false
  },
  "watcher": {
    "minSnapshotInterval": "00:15:00",
    "maxDebounceWait": "00:05:00"
  },
  "backupWindow": {
    "enabled": false,
    "start": "22:00",
    "end": "06:00",
    "days": "all"
  },
  "backup": {
    "deepScanIntervalDays": 7,
    "hydrateCloudFiles": false
  },
  "systemBackup": {
    "enabled": false,
    "includePrograms": true,
    "includeEnvironmentVariables": true,
    "includeWindowsSettings": true,
    "backupInterval": "1.00:00:00",
    "storageType": null,
    "programsStorageType": null,
    "environmentStorageType": null,
    "settingsStorageType": null,
    "excludeSystemPrograms": [
      "Microsoft Visual C++",
      "Microsoft .NET",
      "Windows SDK",
      "KB[0-9]+",
      "Update for",
      "Security Update"
    ]
  },
  "excludedPatterns": [
    "*.tmp",
    "*.temp",
    "~$*",
    "Thumbs.db",
    ".DS_Store",
    "*.log",
    "*.pst",
    "desktop.ini",
    "*.lnk",
    "*.crdownload",
    "*.partial"
  ],
  "excludeGlobs": [],
  "excludePresets": ["office-temp", "system"],
  "encryption": {
    "enabled": false,
    "salt": null,
    "keyDerivationIterations": 1000000,
    "verificationToken": null
  },
  "excludedPaths": [
    "%USERPROFILE%\\Documents\\Temp",
    "%USERPROFILE%\\Downloads",
    "%TEMP%",
    "%LOCALAPPDATA%\\Temp",
    "%WINDIR%",
    "%ProgramFiles%",
    "%ProgramFiles(x86)%"
  ],
  "storageSources": {
    "gdrive": {
      "path": "./backups",
      "options": {
        "client_id": "",
        "client_secret": "",
        "token_folder": "",
        "backup_folder_name": "ReStoreBackups"
      }
    },
    "s3": {
      "path": "./backups",
      "options": {
        "accessKeyId": "",
        "secretAccessKey": "",
        "region": "",
        "bucketName": ""
      }
    },
    "github": {
      "path": "./backups",
      "options": {
        "token": "",
        "repo": "",
        "owner": ""
      }
    },
    "local": {
      "path": "%USERPROFILE%\\ReStoreBackups",
      "options": {}
    },
    "azure": {
      "path": "my-container",
      "options": {
        "connectionString": "",
        "containerName": "my-container"
      }
    },
    "gcp": {
      "path": "my-bucket",
      "options": {
        "bucketName": "my-bucket",
        "credentialPath": "C:\\path\\to\\key.json"
      }
    },
    "dropbox": {
      "path": "/Backups",
      "options": {
        "accessToken": "your-access-token",
        "refreshToken": "optional-refresh-token",
        "appKey": "optional-app-key",
        "appSecret": "optional-app-secret"
      }
    },
    "sftp": {
      "path": "/home/user/backups",
      "options": {
        "host": "sftp.example.com",
        "port": "22",
        "username": "user",
        "password": "",
        "privateKeyPath": "C:\\path\\to\\private_key",
        "passphrase": "optional-passphrase"
      }
    },
    "b2": {
      "path": "my-bucket",
      "options": {
        "keyId": "your-key-id",
        "applicationKey": "your-app-key",
        "serviceUrl": "https://s3.us-west-000.backblazeb2.com",
        "bucketName": "my-bucket"
      }
    }
  }
}
